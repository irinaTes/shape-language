        "availability": {
          "type": "Text",
          "config": { "label": "Availability status", "placeholder": "Open for Q3 / Q4 2026" }
        },
        "lede": {
          "type": "StructuredText",
          "config": {
            "label": "Lede paragraph",
            "placeholder": "Shape Language is how I think…",
            "allowTargetBlank": false,
            "multi": "paragraph,strong,em"
          }
        },
        "quote": {
          "type": "Text",
          "config": { "label": "Pull quote", "placeholder": "I believe the right image…" }
        },
        "quote_cite": {
          "type": "Text",
          "config": { "label": "Pull quote citation", "placeholder": "— Working principle · 01" }
        },
        "cta_heading": {
          "type": "Text",
          "config": { "label": "CTA heading", "placeholder": "Have a frame in your head you can't quite reach?" }
