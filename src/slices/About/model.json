        "portrait": {
          "type": "Image",
          "config": {
            "label": "Portrait photo",
            "constraint": { "width": 800, "height": 1000 },
            "thumbnails": []
          }
        },
        "name_text": {
          "type": "Text",
          "config": { "label": "Name", "placeholder": "Your Name" }
        },
        "discipline": {
          "type": "Text",
          "config": { "label": "Discipline", "placeholder": "CGI · Motion · VFX" }
        },
        "in_the_field": {
          "type": "Text",
          "config": { "label": "In the field since", "placeholder": "Since 2014 · 12 yrs" }
