          "type": "Text",
          "config": { "label": "Heading line 1 (outline)", "placeholder": "Every shape" }
        },
        "heading_line2": {
          "type": "Text",
          "config": { "label": "Heading line 2 (solid)", "placeholder": "has a language" }
        },
        "heading_line3": {
          "type": "Text",
          "config": { "label": "Heading line 3 (outline)", "placeholder": "mine speaks." }
        },
