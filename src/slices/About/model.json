        "cta_link": {
          "type": "Link",
          "config": { "label": "CTA link", "allowTargetBlank": false }
        }
      },
      "items": {
        "section_number": {
          "type": "Text",
          "config": { "label": "Section number", "placeholder": "01" }
        },
        "section_title": {
          "type": "Text",
          "config": { "label": "Section title", "placeholder": "Premise" }
